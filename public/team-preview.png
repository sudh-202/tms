&lt;!-- This is an SVG file as a placeholder for a real PNG image --&gt;
&lt;svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"&gt;
  &lt;rect width="100%" height="100%" fill="#f0f9ff" /&gt;
  &lt;rect x="10" y="10" width="580" height="380" rx="8" fill="#e0f2fe" stroke="#3b82f6" stroke-width="2" /&gt;
  
  &lt;!-- Team Member Circles --&gt;
  &lt;circle cx="150" cy="200" r="60" fill="#bfdbfe" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;circle cx="300" cy="150" r="60" fill="#bfdbfe" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;circle cx="450" cy="200" r="60" fill="#bfdbfe" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;circle cx="225" cy="300" r="60" fill="#bfdbfe" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;circle cx="375" cy="300" r="60" fill="#bfdbfe" stroke="#3b82f6" stroke-width="2" /&gt;
  
  &lt;!-- Connection Lines --&gt;
  &lt;line x1="150" y1="200" x2="300" y2="150" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="300" y1="150" x2="450" y2="200" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="150" y1="200" x2="225" y2="300" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="225" y1="300" x2="375" y2="300" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="375" y1="300" x2="450" y2="200" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="300" y1="150" x2="225" y2="300" stroke="#3b82f6" stroke-width="2" /&gt;
  &lt;line x1="300" y1="150" x2="375" y2="300" stroke="#3b82f6" stroke-width="2" /&gt;
  
  &lt;text x="300" y="50" font-family="Arial" font-size="18" text-anchor="middle" fill="#1e40af"&gt;Team Collaboration&lt;/text&gt;
&lt;/svg&gt; 