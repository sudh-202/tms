<!-- This is an SVG file that we're naming with a .png extension as a placeholder. -->
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="100%" height="100%" fill="#f0f9ff" />
  <rect x="10" y="10" width="580" height="380" rx="8" fill="#e0f2fe" stroke="#3b82f6" stroke-width="2" />
  
  <!-- Graph Bars -->
  <rect x="50" y="300" width="40" height="60" fill="#3b82f6" />
  <rect x="110" y="250" width="40" height="110" fill="#3b82f6" />
  <rect x="170" y="200" width="40" height="160" fill="#3b82f6" />
  <rect x="230" y="220" width="40" height="140" fill="#3b82f6" />
  <rect x="290" y="180" width="40" height="180" fill="#3b82f6" />
  <rect x="350" y="150" width="40" height="210" fill="#3b82f6" />
  <rect x="410" y="220" width="40" height="140" fill="#3b82f6" />
  <rect x="470" y="270" width="40" height="90" fill="#3b82f6" />
  
  <!-- X and Y axis -->
  <line x1="30" y1="360" x2="530" y2="360" stroke="#64748b" stroke-width="2" />
  <line x1="30" y1="360" x2="30" y2="100" stroke="#64748b" stroke-width="2" />
  
  <text x="300" y="50" font-family="Arial" font-size="18" text-anchor="middle" fill="#1e40af">Task Completion Analytics</text>
</svg> 