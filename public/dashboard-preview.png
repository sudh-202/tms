<!-- This is an SVG file that we're naming with a .png extension as a placeholder. In a real app, you'd replace this with a real PNG image. -->
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="600" viewBox="0 0 1200 600">
  <rect width="100%" height="100%" fill="#f0f9ff" />
  <rect x="20" y="20" width="1160" height="560" rx="8" fill="#e0f2fe" stroke="#3b82f6" stroke-width="2" />
  
  <!-- Header -->
  <rect x="40" y="40" width="1120" height="60" rx="4" fill="#dbeafe" />
  <text x="100" y="75" font-family="Arial" font-size="18" font-weight="bold" fill="#1e3a8a">TaskElite Dashboard</text>
  
  <!-- Sidebar -->
  <rect x="40" y="120" width="200" height="440" rx="4" fill="#dbeafe" />
  
  <!-- Main Content -->
  <rect x="260" y="120" width="900" height="200" rx="4" fill="#dbeafe" />
  
  <!-- Task Cards -->
  <rect x="260" y="340" width="280" height="220" rx="4" fill="#dbeafe" />
  <rect x="560" y="340" width="280" height="220" rx="4" fill="#dbeafe" />
  <rect x="860" y="340" width="280" height="220" rx="4" fill="#dbeafe" />
  
  <text x="600" y="300" font-family="Arial" font-size="24" text-anchor="middle" fill="#1e40af">TaskElite Dashboard Preview</text>
</svg> 